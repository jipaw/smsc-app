# /etc/smscd/smscd.env (root:smscd 0640). Rahasia TIDAK di sini — lihat LoadCredential di smscd.service.
PUBLIC_BASE_URL=https://smsc.tailnet-anda.ts.net
HTTP_ADDR=127.0.0.1:8080
METRICS_ADDR=127.0.0.1:9090
TRUST_TAILSCALE_HEADERS=true
# TRUSTED_PROXIES=127.0.0.1/32,::1/128   (default; tambahkan alamat proxy lain bila ada)
ALLOWED_DESTINATION_PREFIXES=+62
DEFAULT_REGION=ID
AUDIT_RETENTION_DAYS=0
DAILY_QUOTA_PER_KEY=0
DAILY_QUOTA_PER_USER=0
QUOTA_TIMEZONE=Asia/Jakarta
LOG_LEVEL=info
# SMTP (opsional): SMTP_HOST=, SMTP_PORT=, SMTP_USERNAME=, SMTP_FROM=, SMTP_PASSWORD_FILE=
