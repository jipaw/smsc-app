# Salin ke .env lalu isi. Rahasia (password DB, SESSION_SECRET, kunci enkripsi) TIDAK di sini: buat dengan ./init-secrets.sh
TS_AUTHKEY=tskey-auth-xxxxxxxx           # Tailscale admin → Settings → Keys, tag:smsc-server, reusable=false
TS_HOSTNAME=smsc
PUBLIC_BASE_URL=https://smsc.tailnet-anda.ts.net
ALLOWED_DESTINATION_PREFIXES=+62         # kosongkan untuk mengizinkan semua tujuan (tidak disarankan)
DEFAULT_REGION=ID
AUDIT_RETENTION_DAYS=0                   # 0 = simpan audit selamanya
# Email (opsional)
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_FROM=
