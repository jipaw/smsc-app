   "type": "stat",
   "title": "Parsial (1 jam)",
   "description": "Retry berisiko bagian ganda dan wajib konfirmasi.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "sum(increase(smsc_messages_partial_total[1h]))",
     "legendFormat": "",
     "refId": "A",
     "instant": true
