{
 "__inputs": [
  {
   "name": "DS_PROMETHEUS",
   "label": "Prometheus",
   "type": "datasource",
   "pluginId": "prometheus",
   "pluginName": "Prometheus"
  }
 ],
 "title": "SMSC — SCIM dan rekonsiliasi",
 "uid": "smsc-scim",
 "tags": [
  "smsc",
  "scim"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 2,
 "editable": true,
 "refresh": "1m",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "description": "Rekonsiliasi grup SCIM → peran dan lalu lintas SCIM. Sumber: /metrics server SMSC. Anotasi: restart proses, deploy (label versi smsc_build_info berubah), dan pergantian leader.",
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Rekonsiliasi grup SCIM → peran",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Run terakhir",
   "description": "Dari database; kosong ('No data') sebelum run pertama atau bila SCIM/pemetaan grup tidak aktif.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "smsc_scim_reconcile_last_run_ok",
     "legendFormat": "",
     "refId": "A",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "auto"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "mappings": [
      {
       "type": "value",
       "options": {
        "1": {
         "text": "OK",
         "color": "green"
        },
        "0": {
         "text": "GAGAL",
         "color": "red"
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Umur run terakhir",
   "description": "Merah > 3 jam (alert SmscScimReconcileStale). Abaikan bila SCIM_RECONCILE_INTERVAL=0.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 4,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "time() - smsc_scim_reconcile_last_run_timestamp_seconds",
     "legendFormat": "",
     "refId": "A",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "auto"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 7200
       },
       {
        "color": "red",
        "value": 10800
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Run ok (24 jam)",
   "description": "Dihitung pada instance leader.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 8,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "sum(increase(smsc_scim_reconcile_runs_total{result=\"ok\"}[24h]))",
     "legendFormat": "",
     "refId": "A",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "auto"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Run gagal (24 jam)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "sum(increase(smsc_scim_reconcile_runs_total{result=\"error\"}[24h]))",
     "legendFormat": "",
     "refId": "A",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "auto"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 6,
   "type": "stat",
   "title": "Peran dikoreksi (24 jam)",
   "description": "Nilai > 0 berarti ada drift atau pemetaan grup baru diterapkan.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 16,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "sum(increase(smsc_scim_reconcile_changed_total[24h]))",
     "legendFormat": "",
     "refId": "A",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "auto"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 7,
   "type": "stat",
   "title": "Panggilan SCIM 5xx (24 jam)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 20,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "sum(increase(smsc_http_requests_total{route=~\"/scim/v2.*\",status=~\"5..\"}[24h]))",
     "legendFormat": "",
     "refId": "A",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "auto"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Run rekonsiliasi per hasil",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "sum by (result) (increase(smsc_scim_reconcile_runs_total[$__rate_interval]))",
     "legendFormat": "{{result}}",
     "refId": "A"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   }
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Pengguna yang dikoreksi",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 12,
    "y": 5,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "sum(increase(smsc_scim_reconcile_changed_total[$__rate_interval]))",
     "legendFormat": "dikoreksi",
     "refId": "A"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   }
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Umur run terakhir (detik)",
   "description": "Naik terus = leader tidak menjalankan rekonsiliasi.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 0,
    "y": 13,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "time() - smsc_scim_reconcile_last_run_timestamp_seconds",
     "legendFormat": "umur",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "vector(10800)",
     "legendFormat": "ambang alert (3 jam)",
     "refId": "B"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   }
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Status run terakhir (1 = ok)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 12,
    "y": 13,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "smsc_scim_reconcile_last_run_ok",
     "legendFormat": "ok",
     "refId": "A"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   }
  },
  {
   "id": 12,
   "type": "row",
   "title": "Lalu lintas SCIM dari IdP",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 21,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 13,
   "type": "timeseries",
   "title": "Permintaan /scim/v2 per status",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 0,
    "y": 22,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "sum by (status) (rate(smsc_http_requests_total{route=~\"/scim/v2.*\"}[$__rate_interval]))",
     "legendFormat": "{{status}}",
     "refId": "A"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   }
  },
  {
   "id": 14,
   "type": "timeseries",
   "title": "Latensi p95 /scim/v2",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "x": 12,
    "y": 22,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(smsc_http_request_duration_seconds_bucket{route=~\"/scim/v2.*\"}[$__rate_interval])))",
     "legendFormat": "p95",
     "refId": "A"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   }
  }
 ],
 "templating": {
  "list": []
 },
 "annotations": {
  "list": [
   {
    "name": "Restart",
    "datasource": {
     "type": "prometheus",
     "uid": "${DS_PROMETHEUS}"
    },
    "enable": true,
    "iconColor": "orange",
    "expr": "changes(process_start_time_seconds[$__interval]) > 0",
    "step": "60s",
    "titleFormat": "Restart",
    "textFormat": "instance {{instance}}",
    "tagKeys": "",
    "useValueForTime": false
   },
   {
    "name": "Deploy (versi berubah)",
    "datasource": {
     "type": "prometheus",
     "uid": "${DS_PROMETHEUS}"
    },
    "enable": true,
    "iconColor": "blue",
    "expr": "smsc_build_info unless smsc_build_info offset $__interval",
    "step": "60s",
    "titleFormat": "Deploy {{version}}",
    "textFormat": "revisi {{revision}} · {{go_version}}",
    "tagKeys": "",
    "useValueForTime": false
   },
   {
    "name": "Pergantian leader",
    "datasource": {
     "type": "prometheus",
     "uid": "${DS_PROMETHEUS}"
    },
    "enable": true,
    "iconColor": "purple",
    "expr": "changes(smsc_leader[$__interval]) > 0",
    "step": "60s",
    "titleFormat": "Leader berganti",
    "textFormat": "instance {{instance}}",
    "tagKeys": "",
    "useValueForTime": false
   }
  ]
 }
}